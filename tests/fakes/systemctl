#!/usr/bin/python3 -I
"""Test stand-in for systemctl: units listed in a file are active; stop ends the launched unit and waits for it."""
import json
import os
import signal
import sys
import time

LOG = os.environ["FAKE_LOG"]
args = sys.argv[1:]
with open(os.path.join(LOG, "systemctl.jsonl"), "a") as handle:
    handle.write(json.dumps(args) + "\n")

try:
    with open(os.environ["FAKE_ACTIVE_UNITS"]) as handle:
        active = handle.read().split()
except OSError:
    active = []

if "is-active" in args:
    sys.exit(0 if args[-1] in active else 3)
if "stop" in args:
    try:
        with open(os.path.join(LOG, "unit.pid")) as handle:
            pid = int(handle.read())
        os.kill(pid, signal.SIGTERM)
        deadline = time.monotonic() + 10
        while time.monotonic() < deadline:
            os.kill(pid, 0)
            time.sleep(0.02)
    except (OSError, ValueError):
        pass
